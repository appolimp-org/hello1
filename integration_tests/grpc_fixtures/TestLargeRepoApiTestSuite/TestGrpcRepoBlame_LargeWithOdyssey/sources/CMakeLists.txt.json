    {
      "hash": "2e03af9c88d45c8849ddb0929bbd48b8051417ad",
      "message": "odyssey: major router and shared logic rework\n\nGoal is to improve overall performance during massive peaks\nof connecting clients.\n\nThis patch makes router a shared structure, instead of\nbeing run in separate system worker thread/coroutine.\n\nNow router and each route object is protected by\nseparate mutex. Worker threads directly access router object\nwithout calls to separate thread.\n",
      "parent_commits": [
        "7807fd91f2a8d4eb7c978d4208986f89553c60aa"
      ],
      "author": {
        "name": "Dmitry Simonenko",
        "email": "pmwkaa@gmail.com",
        "date": "2018-12-06T14:23:15Z"
      },
      "commiter": {
        "name": "Dmitry Simonenko",
        "email": "pmwkaa@gmail.com",
        "date": "2018-12-06T14:23:15Z"
      }
    },
